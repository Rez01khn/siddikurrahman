# Reference only. Never overwrite a live .env or existing APP_KEY blindly.
APP_NAME="Siddikur Rahman"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://siddikurrahman.com
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=replace_with_production_database
DB_USERNAME=replace_with_least_privilege_user
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Remain off until the owner approves all content, media and production URLs.
SEO_INDEXABLE=false